# ==========================================
# BASE DE DATOS (MySQL 8.4) - Consumido por: reservas-db
# ==========================================
MYSQL_DATABASE=reservasdb
MYSQL_USER=reservas_user
MYSQL_PASSWORD=reservas_pass
MYSQL_ROOT_PASSWORD=reservas_root_pass

# ==========================================
# BACKEND (API Node 20 + Express) - Consumido por: reservas-api
# ==========================================
DB_HOST=reservas-db
DB_PORT=3306
DB_NAME=reservasdb
DB_USER=reservas_user
DB_PASSWORD=reservas_pass
DB_POOL_SIZE=10
PORT=3000
SEED_DEMO=true

# ==========================================
# FRONTEND (Nginx Unprivileged) - Consumido por: reservas-frontend
# ==========================================
API_HOST=reservas-api
API_PORT=3000
NGINX_ENVSUBST_FILTER=^API_
